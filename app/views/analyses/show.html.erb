

<div class="card" id="analysis" data-analysis-id="<%= @analysis.id %>" data-analysis-state="<%= @analysis.status %>">
  <h1>FIAP Security Software</h1>

  <p>
    <strong>Status da sua requisição:</strong>
    <span id="analysis-status"><%= @analysis.translate_status %></span>
  </p>

  <% if @analysis.pending? || @analysis.processing? %>
    <p id="analysis-progress" aria-live="polite">
      <span id="analysis-loading-text">Carregando...</span>
      <span id="analysis-loading-spinner" aria-hidden="true">/</span>
    </p>
  <% end %>

  <% if @analysis.failed? %>
    <div id="analysis-error" class="result">
      <strong>Falha ao analisar arquivo:</strong>
      <%= @analysis.result %>
    </div>
  <% else %>
    <div id="analysis-error" class="result" hidden></div>
  <% end %>

  <% if @analysis.processing? || @analysis.completed? %>
    <section id="markdown-section" class="preview">
      <h2>Análise</h2>
      <div id="markdown-preview" class="markdown-preview"></div>
      <%= tag.textarea @analysis.result.to_s, id: "initial-markdown", hidden: true %>
    </section>
  <% else %>
    <section id="markdown-section" class="preview" hidden>
      <h2>Análise</h2>
      <div id="markdown-preview" class="markdown-preview"></div>
      <%= tag.textarea "", id: "initial-markdown", hidden: true %>
    </section>
  <% end %>

  <% if @analysis.completed? %>
    <section id="json-section" class="preview">
      <h2>Exportação JSON</h2>
      <% if @json_content.present? %>
        <p id="json-progress" hidden>Exportação JSON em andamento...</p>
      <% else %>
        <p id="json-progress">Exportação JSON em andamento...</p>
      <% end %>
      <div class="json-preview">
        <% if @json_content.present? %>
          <pre id="json-preview"><%= JSON.pretty_generate(JSON.parse(@json_content)) %></pre>
        <% else %>
          <pre id="json-preview"></pre>
        <% end %>
      </div>
    </section>
  <% else %>
    <section id="json-section" class="preview" hidden>
      <h2>Exportação JSON</h2>
      <p id="json-progress">Exportação JSON em andamento...</p>
      <div class="json-preview">
        <pre id="json-preview"></pre>
      </div>
    </section>
  <% end %>

  <% if @analysis.completed? %>
    <div id="result-links" class="result">
      <%= link_to "Visualizar em Markdown", analysis_path(@analysis, format: :md) %>

      <% if @json_content.present? %>
        <span id="json-link">
          <%= link_to "Visualizar JSON", analysis_analysis_export_path(@analysis) %>
        </span>
        <span id="json-link-pending" hidden>Exportação JSON em andamento</span>
      <% else %>
        <span id="json-link" hidden>
          <%= link_to "Visualizar JSON", analysis_analysis_export_path(@analysis) %>
        </span>
        <span id="json-link-pending">Exportação JSON em andamento</span>
      <% end %>
    </div>
  <% else %>
    <div id="result-links" class="result" hidden>
      <%= link_to "Visualizar em Markdown", analysis_path(@analysis, format: :md) %>
      <span id="json-link" hidden>
        <%= link_to "Visualizar JSON", analysis_analysis_export_path(@analysis) %>
      </span>
      <span id="json-link-pending">Exportação JSON em andamento</span>
    </div>
  <% end %>

  <section id="resolutions-section" class="preview" <%= "hidden" unless @json_content.present? %>>
    <h2>Correções sugeridas</h2>
    <%= button_to "Gerar correções",
      analysis_risk_assessment_resolutions_path(@analysis),
      method: :post,
      id: "generate-resolutions",
      disabled: @analysis.analysis_export&.resolution_generation_status.in?(%w[queued processing completed]) %>
    <p id="resolutions-progress" aria-live="polite" <%= "hidden" unless @analysis.analysis_export&.resolution_generation_status.in?(%w[queued processing]) %>>
      <span id="resolutions-loading-text">Gerando correções...</span>
      <span id="resolutions-loading-spinner" aria-hidden="true">/</span>
    </p>
    <p id="resolutions-error" class="result" hidden></p>
    <p id="resolutions-empty" <%= "hidden" if @risk_assessment_resolutions.any? %>>Nenhuma correção foi gerada ainda.</p>
    <ul id="resolution-links">
      <% @risk_assessment_resolutions.each do |resolution| %>
        <% if resolution.file.attached? %>
          <li>
            <%= link_to "#{resolution.risk_type.humanize} — #{resolution.impact_category}",
              analysis_risk_assessment_resolution_path(@analysis, resolution) %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>
</div>

<script type="module">
  import { createConsumer, logger as actionCableLogger } from "<%= asset_path("actioncable.esm.js") %>"
  import { marked } from "https://cdn.jsdelivr.net/npm/marked@16.1.1/+esm"
  import DOMPurify from "https://cdn.jsdelivr.net/npm/dompurify@3.2.6/+esm"

  const root = document.getElementById("analysis")
  const status = document.getElementById("analysis-status")
  const progress = document.getElementById("analysis-progress")
  const error = document.getElementById("analysis-error")
  const markdownSection = document.getElementById("markdown-section")
  const markdownPreview = document.getElementById("markdown-preview")
  const jsonSection = document.getElementById("json-section")
  const jsonPreview = document.getElementById("json-preview")
  const jsonProgress = document.getElementById("json-progress")
  const resultLinks = document.getElementById("result-links")
  const jsonLink = document.getElementById("json-link")
  const jsonLinkPending = document.getElementById("json-link-pending")
  const resolutionsSection = document.getElementById("resolutions-section")
  const generateResolutions = document.getElementById("generate-resolutions")
  const resolutionsProgress = document.getElementById("resolutions-progress")
  const resolutionsError = document.getElementById("resolutions-error")
  const resolutionsEmpty = document.getElementById("resolutions-empty")
  const resolutionLinks = document.getElementById("resolution-links")
  const loadingStates = ["Carregando...", "Carregando..", "Carregando."]
  const resolutionLoadingStates = ["Gerando correções...", "Gerando correções..", "Gerando correções."]
  const spinnerStates = ["/", "—", "\\", "|"]
  const loadingAnimations = new Map()
  let markdown = document.getElementById("initial-markdown").value
  let json = jsonPreview.textContent
  const analysisId = root.dataset.analysisId

  const startLoadingAnimation = (name, text, spinner, states) => {
    if (!text || !spinner || loadingAnimations.has(name)) return

    let frame = 0
    const animation = window.setInterval(() => {
      frame += 1
      text.textContent = states[frame % states.length]
      spinner.textContent = spinnerStates[frame % spinnerStates.length]
    }, 350)
    loadingAnimations.set(name, animation)
  }

  const stopLoadingAnimation = (name) => {
    window.clearInterval(loadingAnimations.get(name))
    loadingAnimations.delete(name)
  }

  startLoadingAnimation(
    "analysis",
    document.getElementById("analysis-loading-text"),
    document.getElementById("analysis-loading-spinner"),
    loadingStates
  )

  if (!resolutionsProgress.hidden) {
    startLoadingAnimation(
      "resolutions",
      document.getElementById("resolutions-loading-text"),
      document.getElementById("resolutions-loading-spinner"),
      resolutionLoadingStates
    )
  }

  const renderMarkdown = () => {
    markdownPreview.innerHTML = DOMPurify.sanitize(marked.parse(markdown))
  }

  if (markdown) renderMarkdown()

  const consumer = createConsumer()
  const subscription = consumer.subscriptions.create(
    { channel: "AnalysisChannel", analysis_id: analysisId },
    {

      rejected() {
        console.error("[AnalysisChannel] subscription rejected", {
          analysisId,
          timestamp: new Date().toISOString()
        })
      },
      received(data) {
        if (data.status) status.textContent = data.status

        switch (data.event) {
          case "analysis_started":
            progress.hidden = false
            markdownSection.hidden = false
            break
          case "analysis_delta":
            markdownSection.hidden = false
            markdown = typeof data.content === "string" ? data.content : markdown + data.delta
            renderMarkdown()
            break
          case "analysis_completed":
            progress.hidden = true
            stopLoadingAnimation("analysis")
            resultLinks.hidden = false
            jsonSection.hidden = false
            jsonProgress.hidden = false
            break
          case "analysis_failed":
            progress.hidden = true
            stopLoadingAnimation("analysis")
            error.hidden = false
            error.textContent = "Falha ao analisar arquivo: " + data.error
            break
          case "export_started":
            jsonSection.hidden = false
            jsonProgress.hidden = false
            break
          case "export_delta":
            jsonSection.hidden = false
            json += data.delta
            jsonPreview.textContent = json
            break
          case "export_completed":
            jsonProgress.hidden = true
            jsonLink.hidden = false
            jsonLinkPending.hidden = true
            resolutionsSection.hidden = false
            break
          case "export_failed":
            jsonProgress.textContent = "Falha ao exportar JSON: " + data.error
            break
          case "resolutions_started":
            generateResolutions.disabled = true
            resolutionsProgress.hidden = false
            resolutionsError.hidden = true
            startLoadingAnimation(
              "resolutions",
              document.getElementById("resolutions-loading-text"),
              document.getElementById("resolutions-loading-spinner"),
              resolutionLoadingStates
            )
            break
          case "resolutions_completed":
            resolutionsProgress.hidden = true
            stopLoadingAnimation("resolutions")
            resolutionsEmpty.hidden = data.resolutions.length > 0
            resolutionLinks.replaceChildren(...data.resolutions.map((resolution) => {
              const item = document.createElement("li")
              const link = document.createElement("a")
              link.href = resolution.url
              link.textContent = resolution.label
              item.appendChild(link)
              return item
            }))
            break
          case "resolutions_failed":
            generateResolutions.disabled = false
            resolutionsProgress.hidden = true
            stopLoadingAnimation("resolutions")
            resolutionsError.hidden = false
            resolutionsError.textContent = "Falha ao gerar correções: " + data.error
            break
        }
      }
    }
  )

  window.addEventListener("pagehide", () => {
    loadingAnimations.forEach((animation) => window.clearInterval(animation))
    loadingAnimations.clear()
    subscription.unsubscribe()
    consumer.disconnect()
  }, { once: true })
</script>
